# Environment Configuration for Bulk Certificate Generator
APP_NAME=Bulk Certificate Generator API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Database Configuration (SQLite default for local development, PostgreSQL compatible)
DATABASE_URL=sqlite:///./certificates.db

# Storage Directory for Generated PDF Files
GENERATED_FILES_DIR=generated

# Limits
MAX_RECIPIENTS_PER_JOB=1000
